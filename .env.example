# Exactly "review" or "live". Anything else fails the build (T1).
# review: every route is noindex, placeholder facts and unapproved clips are allowed.
# live:   the build refuses while any todo() label or unapproved clip remains.
# When VERCEL_ENV=production the build also requires "live".
SITE_STAGE=review

# Public site URL for og:image. Falls back to VERCEL_URL on previews.
# SITE_URL=https://hobbsmedia.co

# Where scripts/encode.ts resolves relative manifest `source` paths (never committed).
# CLIPS_SOURCE_DIR=/Volumes/Footage/hobbs

# x264 preset for the encoder (default medium).
# ENCODE_PRESET=slow
